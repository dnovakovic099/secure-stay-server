# OpenAI Configuration
OPENAI_API_KEY=

# Employee assistant ("Ask SecureStay" widget).
#
# Rollout is default-OFF so deploying the code does not put the widget in front
# of every employee at once. Either switch it on for everyone, or pilot it with
# a few addresses first.
ASSISTANT_ENABLED=false
ASSISTANT_PILOT_EMAILS=

# Models are optional — these are the defaults. The fast model drives the tool
# loop and answers plain lookups; the deep model handles real synthesis.
ASSISTANT_MODEL=gpt-5.6-luna
ASSISTANT_DEEP_MODEL=gpt-5.6-terra

ASANA_PAT=
ASANA_WORKSPACE_ID=
ASANA_PROJECT_ID=
ASANA_SECTION_ID=
# Asana Custom Field GIDs (optional - falls back to description if empty)
ASANA_CF_PHONE=
ASANA_CF_TIMEZONE=
ASANA_CF_SERVICE_TYPE=
ASANA_CF_SALES_NOTES=
ASANA_CF_SALES_AGENT=
ASANA_CF_EMAIL=
ASANA_CF_PROPERTY_ADDRESS=
ASANA_CF_MGT_FEE=
ASANA_CF_CURRENT_LISTING_LINK=
ASANA_CF_TARGET_START_DATE=
ASANA_CF_TARGET_LIVE_DATE=


SUPPORT_EMAIL=
SUPPORT_EMAIL_PASSWORD=

SLACK_SIGNING_SECRET=

ENABLE_CLEANER_CHECKOUT_SMS=true
CLEANER_CHECKOUT_SMS_SENDER_NUMBER=

# Daily Sales Report (Atlas growth leads)
BATCHDATA_API_KEY=
REALESTATE_API_KEY=
APIFY_API_TOKEN=
