PORT=
NODE_ENV=

# ---- Smart locks ----
# Seam aggregator (August, Yale, Schlage via partner, etc.)
SEAM_API_KEY=

# Sifely Open API (cus-openapi.sifely.com). Prefer the sk- API key from
# connect.sifely.com (or from POST /system/smart/login). Username/password
# will mint a key at runtime if SIFELY_API_KEY is blank.
SIFELY_API_KEY=
SIFELY_CLIENT_ID=
SIFELY_USERNAME=
SIFELY_PASSWORD=
# Optional host overrides; defaults target the Open API production host.
SIFELY_OPENAPI_URL=
SIFELY_API_URL=
# Sent as X-App-Name. Only needed on the free Developer plan, which rejects
# device calls once the account has more than 5 locks. Leave blank when
# subscribed.
SIFELY_APP_NAME=

# TTLock/Sciener developer app. Required for the ttlock provider (DD Lock +
# TT Lock accounts) and usable as a fallback client id for Sifely.
SCIENER_CLIENT_ID=
SCIENER_CLIENT_SECRET=

# JSON array of TTLock/DD Lock consumer logins, e.g.
# [{"label":"ttlock","username":"a@b.com","password":"..."},{"label":"ddlock","username":"...","password":"..."}]
TTLOCK_ACCOUNTS_JSON=

# JSON array of Schlage Encode accounts. Emails MUST be lowercase.
# [{"label":"main","email":"a@b.com","password":"..."},{"label":"bayside","email":"...","password":"..."}]
SCHLAGE_ACCOUNTS_JSON=

DATABASE_URL=
DATABASE_PORT=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=

HOST_AWAY_CLIENT_ID=
HOST_AWAY_CLIENT_SECRET=

SCIENER_CLIENT_ID=
SCIENER_CLIENT_SECRET=

SUPABASE_URL= 
SUPABASE_KEY=
SUPABASE_ROLE_KEY=

STRIPE_SECRET_KEY=

JWT_SECRET= 

SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_TO=

CLIENT_URL=
CHARGE_AUTOMATION_API_KEY=
CHARGE_AUTOMATION_API_URL=

MOBILE_API_BASE_URL=
OWNER_PORTAL_API_BASE_URL=

SLACK_BOT_TOKEN=

SHARED_DRIVE_ID=

OPEN_PHONE_API_KEY=
OPEN_PHONE_SENDER_NUMBER=

# OpenAI Configuration
OPENAI_API_KEY=

# Inbox guest-reply AI — second-pass Editor (rewrite risky drafts).
# shadow (default): run Editor + log; keep original draft; score verifier still gates autosend
# live: apply Editor rewrite; block autosend when still_unanswered is non-empty
# off: disabled (score verifier only)
AI_MESSAGING_EDITOR_MODE=shadow
# Optional override; defaults to AI_MESSAGING_MODEL / gpt-4.1
# AI_MESSAGING_EDITOR_MODEL=

# Daily Editor optimize (4:00 AM ET) — distill yesterday's misses into Editor lessons.
AI_EDITOR_OPTIMIZE_ENABLED=true
# AI_EDITOR_OPTIMIZE_MODEL=
# AI_EDITOR_OPTIMIZE_SLACK=true
# AI_EDITOR_OPTIMIZE_SLACK_CHANNEL=

# Employee assistant ("Ask SecureStay" widget).
#
# Rollout is default-OFF so deploying the code does not put the widget in front
# of every employee at once. Either switch it on for everyone, or pilot it with
# a few addresses first.
ASSISTANT_ENABLED=false
ASSISTANT_PILOT_EMAILS=

# Models are optional — these are the defaults. The fast model drives the tool
# loop and answers plain lookups; the deep model handles real synthesis.
ASSISTANT_MODEL=gpt-4.1-mini
ASSISTANT_DEEP_MODEL=gpt-4.1

ASANA_PAT=
ASANA_WORKSPACE_ID=
ASANA_PROJECT_ID=
ASANA_SECTION_ID=
# Asana Custom Field GIDs (optional - falls back to description if empty)
ASANA_CF_PHONE=
ASANA_CF_TIMEZONE=
ASANA_CF_SERVICE_TYPE=
ASANA_CF_SALES_NOTES=
ASANA_CF_SALES_AGENT=
ASANA_CF_EMAIL=
ASANA_CF_PROPERTY_ADDRESS=
ASANA_CF_MGT_FEE=
ASANA_CF_CURRENT_LISTING_LINK=
ASANA_CF_TARGET_START_DATE=
ASANA_CF_TARGET_LIVE_DATE=


SUPPORT_EMAIL=
SUPPORT_EMAIL_PASSWORD=

SLACK_SIGNING_SECRET=

ENABLE_CLEANER_CHECKOUT_SMS=true
CLEANER_CHECKOUT_SMS_SENDER_NUMBER=

# Daily Sales Report (Atlas growth leads)
BATCHDATA_API_KEY=
REALESTATE_API_KEY=
APIFY_API_TOKEN=
SALES_REPORT_ENABLED=true
SALES_REPORT_SLACK_CHANNEL="#sales-leads"
SALES_REPORT_MARKETS=
SALES_REPORT_MAX_SKIP_TRACES=15
SALES_REPORT_LEADS_PER_SECTION=5

# Reddit Ads API OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=https://securestay.ai/securestay_api/oauth/reddit/callback
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=SecureStay/1.0
REDDIT_OAUTH_SCOPES=adsread adsedit adsconversions
# Google Ads API (lead conversion upload + campaign scripts)
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_REDIRECT_URI=https://securestay.ai/securestay_api/oauth/google-ads/callback
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_CONVERSION_ACTION=
